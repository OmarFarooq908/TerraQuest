{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OmarFarooq908/TerraQuest/schemas/mission_intent.schema.json",
  "title": "TerraQuest MissionIntent",
  "description": "MissionIntent schema_version 1.0 — language→scoring contract after sanitize/repair (docs/mission-intent.md). PreferenceVector lists every dimension (defaults materialize missing keys to 0).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "constraints",
    "preferences",
    "goals",
    "source"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "constraints": { "$ref": "#/$defs/HardConstraints" },
    "preferences": { "$ref": "#/$defs/PreferenceVector" },
    "goals": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "discovery",
          "photography",
          "camping",
          "hiking",
          "history",
          "wildlife",
          "relaxation",
          "surprise"
        ]
      }
    },
    "source": {
      "type": "string",
      "enum": ["rules", "llm", "hybrid"]
    },
    "interpreter_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "intent_repairs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "raw_prompt": { "type": ["string", "null"] }
  },
  "$defs": {
    "HardConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "days": { "type": ["number", "null"] },
        "vehicle": { "type": ["string", "null"] },
        "vehicle_class": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "string",
              "enum": ["hatchback", "sedan", "suv", "suv_4x4"]
            }
          ]
        },
        "party_size": { "type": ["integer", "null"] },
        "budget_per_person": { "type": ["number", "null"] },
        "currency": { "type": ["string", "null"] },
        "origin": { "type": ["string", "null"] },
        "origin_lon": { "type": ["number", "null"] },
        "origin_lat": { "type": ["number", "null"] },
        "departure": { "type": ["string", "null"] },
        "return_by": { "type": ["string", "null"] }
      }
    },
    "PreferenceVector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beauty",
        "water",
        "forest",
        "geology",
        "wildlife",
        "remoteness",
        "accessibility",
        "novelty",
        "photography",
        "danger",
        "solitude",
        "hiking",
        "camping",
        "history",
        "human_activity"
      ],
      "properties": {
        "beauty": { "type": "number", "minimum": -1, "maximum": 1 },
        "water": { "type": "number", "minimum": -1, "maximum": 1 },
        "forest": { "type": "number", "minimum": -1, "maximum": 1 },
        "geology": { "type": "number", "minimum": -1, "maximum": 1 },
        "wildlife": { "type": "number", "minimum": -1, "maximum": 1 },
        "remoteness": { "type": "number", "minimum": -1, "maximum": 1 },
        "accessibility": { "type": "number", "minimum": -1, "maximum": 1 },
        "novelty": { "type": "number", "minimum": -1, "maximum": 1 },
        "photography": { "type": "number", "minimum": -1, "maximum": 1 },
        "danger": { "type": "number", "minimum": -1, "maximum": 1 },
        "solitude": { "type": "number", "minimum": -1, "maximum": 1 },
        "hiking": { "type": "number", "minimum": -1, "maximum": 1 },
        "camping": { "type": "number", "minimum": -1, "maximum": 1 },
        "history": { "type": "number", "minimum": -1, "maximum": 1 },
        "human_activity": { "type": "number", "minimum": -1, "maximum": 1 }
      }
    }
  }
}
