{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OmarFarooq908/TerraQuest/schemas/catalog_feature.schema.json",
  "title": "TerraQuest catalog Feature properties",
  "description": "Catalog GeoJSON Feature properties contract (catalog_schema_version 0.3.0 / RFC-0003)",
  "type": "object",
  "required": [
    "id",
    "name",
    "generator",
    "provenance",
    "evidence",
    "densify"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "kind": { "type": "string" },
    "generator": { "type": "string", "minLength": 1 },
    "generator_version": { "type": "string" },
    "catalog_schema_version": { "const": "0.3.0" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "provenance": { "$ref": "#/$defs/Provenance" },
    "evidence": { "type": "object" },
    "densify": { "$ref": "#/$defs/DensifyHook" },
    "building_density": { "type": "number" },
    "crowd": { "type": "number" },
    "forest": { "type": "number" },
    "hazard": { "type": "number" },
    "protected": { "type": "number" },
    "slope": { "type": "number" },
    "has_water": { "type": "boolean" },
    "elevation_m": { "type": ["number", "null"] },
    "relief_m": { "type": ["number", "null"] },
    "highway": { "type": ["string", "null"] }
  },
  "$defs": {
    "Provenance": {
      "type": "object",
      "required": ["sources", "method"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "method": { "type": "string", "minLength": 1 },
        "osm_id": { "type": ["integer", "null"] },
        "osm_type": { "type": ["string", "null"] },
        "layer": { "type": ["string", "null"] },
        "dem_tile": { "type": ["string", "null"] },
        "extra": { "type": "object" }
      }
    },
    "DensifyHook": {
      "type": "object",
      "required": ["cell_id"],
      "properties": {
        "cell_id": { "type": "string", "minLength": 1 },
        "parent_id": { "type": ["string", "null"] },
        "densify_allowed": { "type": "boolean" },
        "grid_res_deg": { "type": "number" }
      }
    }
  }
}
